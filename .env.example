# LLM Provider: "gemini" or "openai" (auto-detected if only one key is set)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Get at https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily Search API Key (Get at https://tavily.com/)
# Optional: If left blank, the assistant automatically falls back to DuckDuckGo!
TAVILY_API_KEY=

# Max iterations to re-search when evidence gaps are found
MAX_RESEARCH_LOOPS=2
